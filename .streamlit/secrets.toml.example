SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-publishable-key"
DEEPSEEK_API_KEY = "your-deepseek-key"

# URL used by the Streamlit host to load the plugin backend.
PLUGIN_BASE_URL = "http://localhost:8787"

# Must match PLUGIN_REQUIRED_TOKEN on the plugin server when token auth is enabled.
PLUGIN_TOKEN = "replace-with-a-long-random-value"
