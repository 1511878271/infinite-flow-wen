{
  "name": "plugandplay-ai-plugin",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,ui,web -c green,cyan,magenta \"npm:dev:server\" \"npm:dev:ui\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @plugandplay/plugin-server run dev",
    "dev:ui": "npm --workspace @plugandplay/plugin-ui run dev",
    "dev:web": "npm --workspace web-app run dev",
    "build": "npm run build:server && npm run build:ui && npm run build:web",
    "build:server": "npm --workspace @plugandplay/plugin-server run build",
    "build:ui": "npm --workspace @plugandplay/plugin-ui run build",
    "build:web": "npm --workspace web-app run build",
    "start": "npm --workspace @plugandplay/plugin-server run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
